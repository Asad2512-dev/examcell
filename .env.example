APP_NAME=ExamCell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
EXAMCELL_SEED_DEMO=false
EXAMCELL_DEMO_PASSWORD=12345678
SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single
DB_CONNECTION=mysql
# Replace these with the settings shown in your own MAMP installation.
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=examcell
DB_USERNAME=YOUR_MAMP_USERNAME
DB_PASSWORD=YOUR_MAMP_PASSWORD
DB_SOCKET=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=examcell@example.invalid
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
MAX_DUTIES_PER_DAY=2
# Requires institutional confirmation: final exams only, latest published course attempt.
CGPA_ATTEMPT_POLICY=latest
QUEUE_CONNECTION=database

# Web restore upload size; also configure PHP post_max_size/upload_max_filesize.
RESTORE_UPLOAD_MAX_KB=524288
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
